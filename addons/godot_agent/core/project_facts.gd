@tool
extends RefCounted
## Datos del proyecto para las instrucciones del agente (m11-07): lo que se puede leer sin pensar
## (versión de Godot, escena principal, autoloads, capas con nombre, acciones de input, carpetas) en
## una sección de Markdown entre marcadores, para regenerarla sin pisar lo que el usuario escribió.

const BEGIN := "<!-- godot-agent:project-facts -->"
const END := "<!-- /godot-agent:project-facts -->"
## Las acciones `ui_*` son las del motor: no dicen nada del juego.
const BUILTIN_ACTION_PREFIX := "ui_"
const LAYER_GROUPS := {"2d_physics": "2D physics", "3d_physics": "3D physics", "2d_render": "2D render", "3d_render": "3D render",
	"2d_navigation": "2D navigation", "3d_navigation": "3D navigation", "avoidance": "avoidance"}


## La sección (con sus marcadores) a partir de `settings`: `{key: value}` como ProjectSettings
## (`application/run/main_scene`, `autoload/<Name>`, `layer_names/<group>/layer_<n>`, `input/<action>`)
## y `folders`, las carpetas de primer nivel del proyecto.
static func section(settings: Dictionary, godot_version: String, folders: PackedStringArray) -> String:
	var lines: PackedStringArray = [BEGIN, "## Project facts", "", "Generated by Godot Agent Harness from the project settings; regenerate it from Extensions → Instructions.", ""]
	var name := str(settings.get("application/config/name", ""))
	lines.append("- Godot %s%s." % [godot_version, (", project \"%s\"" % name) if not name.is_empty() else ""])
	var main := str(settings.get("application/run/main_scene", ""))
	if not main.is_empty():
		lines.append("- Main scene: `%s`." % main)
	var autoloads: PackedStringArray = []
	var layers: PackedStringArray = []
	var actions: PackedStringArray = []
	var keys := settings.keys()
	keys.sort()
	for key: String in keys:
		if key.begins_with("autoload/"):
			autoloads.append("`%s` (%s)" % [key.trim_prefix("autoload/"), str(settings[key]).trim_prefix("*")])
		elif key.begins_with("layer_names/") and not str(settings[key]).is_empty():
			var parts := key.split("/")
			layers.append("%s %s: %s" % [LAYER_GROUPS.get(parts[1], parts[1]), parts[2].trim_prefix("layer_"), settings[key]])
		elif key.begins_with("input/") and not key.trim_prefix("input/").begins_with(BUILTIN_ACTION_PREFIX):
			actions.append("`%s`" % key.trim_prefix("input/"))
	if not autoloads.is_empty():
		lines.append("- Autoloads: %s." % ", ".join(autoloads))
	if not layers.is_empty():
		lines.append("- Named layers: %s." % "; ".join(layers))
	if not actions.is_empty():
		lines.append("- Input actions: %s." % ", ".join(actions))
	if not folders.is_empty():
		lines.append("- Top-level folders: %s." % ", ".join(Array(folders).map(func(folder: String) -> String: return "`%s/`" % folder)))
	lines.append(END)
	return "\n".join(lines)


## `text` con la sección reemplazada si ya estaba, o agregada al final si no.
static func merge(text: String, facts: String) -> String:
	var start := text.find(BEGIN)
	var end := text.find(END)
	if start >= 0 and end > start:
		return text.left(start) + facts + text.substr(end + END.length())
	return (text.strip_edges(false, true) + "\n\n" if not text.strip_edges().is_empty() else "") + facts + "\n"


## Los ProjectSettings que usa section(), leídos del proyecto abierto.
static func current_settings() -> Dictionary:
	var result := {}
	for property: Dictionary in ProjectSettings.get_property_list():
		var key := str(property.name)
		if key in ["application/config/name", "application/run/main_scene"] or key.begins_with("autoload/") or key.begins_with("layer_names/") or key.begins_with("input/"):
			result[key] = ProjectSettings.get_setting(key)
	return result


## Carpetas de primer nivel de `root`, sin las ocultas ni las que tienen .gdignore.
static func top_folders(root: String) -> PackedStringArray:
	var result: PackedStringArray = []
	for folder: String in DirAccess.get_directories_at(root):
		if not folder.begins_with(".") and not FileAccess.file_exists(root.path_join(folder).path_join(".gdignore")):
			result.append(folder)
	return result
